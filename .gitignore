# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# -----------------------------------------------------------------------------
# Secrets & local credentials -- NEVER commit these to a public repository
# -----------------------------------------------------------------------------
# Google OAuth client secret files (downloaded from Google Cloud Console)
client_secret*.json
**/client_secret*.json

# FlutterFire / Firebase generated options (contain API credentials)
firebase_options.dart

# Environment / API key files
.env
.env.*
*.env
**/.env*

# iOS Firebase config (re-download from the Firebase console per machine/team)
ios/Runner/GoogleService-Info.plist

# Android Firebase config: NOT committed for this public repo (contains an API key).
# Copy android/app/google-services.json.example to android/app/google-services.json
# and fill in your real values (re-download from the Firebase console). See README.
android/app/google-services.json

# Keystore / signing material
*.jks
*.keystore
key.properties
